# =============================================================================
# AL-HADAB Enterprise API — Environment Variables (SERVER TEMPLATE)
# =============================================================================
# Copy this file to packages/server/.env and fill in the real values.
# NEVER commit .env to git — it is already in .gitignore.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Development: use your Neon direct connection string
# Production (Render): set DATABASE_URL in the Render dashboard
# Format: postgresql://USER:PASSWORD@ep-xxx.REGION.neon.tech/DBNAME?sslmode=require&connect_timeout=30
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.neon.tech/DBNAME?sslmode=require&connect_timeout=30

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate strong random secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: allow local Vite dev server
# Production (Render): replace with your Vercel deployment URL
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
