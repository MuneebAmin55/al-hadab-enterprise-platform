# =============================================================================
# AL-HADAB Enterprise Client — Environment Variables (CLIENT TEMPLATE)
# =============================================================================
# Development:
#   Leave VITE_API_BASE_URL empty or unset to automatically use the Vite dev proxy (/api/v1 -> http://localhost:5000)
#
# Production (Vercel):
#   Set VITE_API_BASE_URL to your live Render backend URL:
#   VITE_API_BASE_URL=https://al-hadab-enterprise-platform.onrender.com/api/v1
# =============================================================================

VITE_API_BASE_URL=https://al-hadab-enterprise-platform.onrender.com/api/v1
