# =============================================================================
# AL-HADAB Enterprise Client — Environment Variables (CLIENT TEMPLATE)
# =============================================================================
# Copy this file to packages/client/.env if custom environment overrides are needed.
#
# Development:
#   Leave VITE_API_BASE_URL empty or unset to automatically use the Vite dev proxy (/api/v1 -> http://localhost:5000)
#
# Production (Vercel):
#   Set VITE_API_BASE_URL to your Render backend URL + /api/v1
#   Example: https://your-render-service.onrender.com/api/v1
# =============================================================================

VITE_API_BASE_URL=
